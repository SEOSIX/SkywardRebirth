{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "f9cf08db334b40cfb2fe3dedbac95c4a",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ClockEffect (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -1842.000244140625,
            "y": 686.0001220703125,
            "width": 220.0,
            "height": 117.99993896484375
        }
    },
    "m_Slots": [
        {
            "m_Id": "eae7c5c5a732449e8fc9e931694ca303"
        },
        {
            "m_Id": "db3eab8199da47ceb25c962041b2c5f9"
        },
        {
            "m_Id": "7b3aada391d849f0920776e9b652cdf4"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ClockEffect",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float t = Time / Interval;\r\nfloat cycle = floor(t);\r\nfloat phase = frac(t);\r\n\r\n// 0.0 à 0.7 : le shader tourne normalement\r\n// 0.7 à 1.0 : le shader s'arrête et rebondit\r\nfloat motion = 0.0;\r\n\r\nif (phase < 0.7) {\r\n    // On normalise la vitesse sur la phase de mouvement\r\n    motion = phase / 0.7; \r\n} else {\r\n    // Phase d'arrêt + Rebond élastique\r\n    float stopTime = (phase - 0.7) / 0.3; // Temps de l'arrêt (0 à 1)\r\n    \r\n    // Formule d'atténuation pour l'effet ressort (bouncing)\r\n    // Le sinus crée l'oscillation, l'exponentielle négative l'amortit\r\n    float bounce = sin(stopTime * 3.14159 * 3.0) * exp(-stopTime * 4.0) * 0.15;\r\n    \r\n    motion = 1.0 + bounce;\r\n}\r\n\r\n// On réassemble les cycles pour que la rotation reprenne là où elle s'est arrêtée\r\nOut = (cycle + motion) * Interval;"
}

